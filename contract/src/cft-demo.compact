// SPDX-License-Identifier: MIT
//
// CFT Demo: a compliance-flavoured deployment of OpenZeppelin's
// ConfidentialFungibleToken (CFT) for Midnight.
//
// Composition (all OpenZeppelin Contracts for Compact v0.3.0-alpha.2, vendored
// under ./oz, the last release that targets the ledger-8 / compact 0.31 stack
// that Preview, Preprod and Mainnet run today):
//
//   ConfidentialFungibleToken   ElGamal-encrypted balances, memo channel,
//                               register / sweep / transfer / _mint / _burn
//   ...PublicSupply             public totalSupply paired with mint / burn
//   Ownable                     issuer authority (witness-derived identity)
//
// What this wrapper adds on top of the OZ module:
//
//   * viewing-key escrow at registration: `register` is permissionless (any
//     wallet in the wild can hold the token), but the circuit also encrypts
//     the caller's viewing key to a COMPLIANCE KEY fixed at deployment and
//     proves that the escrowed key is the one behind the encryption key it
//     just registered. Receiving requires registration (the OZ module refuses
//     unregistered receivers), so every holder is escrowed by construction,
//     with no allowlist and no issuer action. This is the confidential
//     counterpart of ERC-7943's `forceTransfer`: the authority can act on any
//     holder it has never heard of.
//   * issuer-gated mint (supply-accounted)
//   * holder burn (supply-accounted)
//   * setFrozen: a frozen account cannot send, receive, burn or be minted to.
//     Uses the caller-identity gating pattern the OZ module documents: every
//     caller-authenticating circuit RETURNS the caller's accountId, and the
//     wrapper asserts on that returned value.
//   * setPaused: global circuit breaker for value movement.
//   * seize: the OZ base deliberately leaves admin seize out because the
//     authority cannot see balances. Here the issuer CAN seize any frozen
//     account: it opens the escrow with the compliance key off-chain, and the
//     circuit proves in zero knowledge that the supplied viewing key is the
//     account's and opens its balance to exactly `amount`, zeroes the account
//     and credits a treasury with the same amount, conserving totalSupply.
//
// The viewing key concept is the CFT's own: EK decrypts memos (incoming
// amounts) and balances but cannot spend, because spending also needs SK
// (accountId = persistentHash(SK)). What is escrowed is the Jubjub scalar
// derived from EK (`secretToScalar`), which is all a viewer ever needs.
//
// Only eight impure circuits are exported. Metadata, balances, memos, supply,
// escrow and frozen set are read straight from the public ledger state.
// Every exported impure circuit adds ~2.2 KB of verifier key to the deploy tx
// and the per-block write budget on Preview is 50,000 bytes: ten circuits fit,
// twelve were rejected ("Transaction would exhaust the block limits"), hence
// the boolean toggles instead of paired circuits. Pure circuits cost nothing.

pragma language_version >= 0.23.0;

import CompactStandardLibrary;

import "./oz/token/ConfidentialFungibleToken" prefix CFT_;
import "./oz/token/extensions/ConfidentialFungibleTokenPublicSupply" prefix Supply_;
import "./oz/access/Ownable" prefix Ownable_;
import "./oz/crypto/ElGamal" prefix ElGamal_;
import "./oz/crypto/EcdhMask" prefix EcdhMask_;

export { ElGamal_Ciphertext, EcdhMask_Ciphertext };

// Public ledger surface (read off-chain, no circuits needed).
export {
  CFT__balances,
  CFT__pending,
  CFT__encryptionKeys,
  CFT__memos,
  CFT__name,
  CFT__symbol,
  CFT__decimals,
  Supply__totalSupply,
  Ownable__owner
};

// ── Compliance state ───────────────────────────────────────────────────────

/** Public key the viewing keys are escrowed to. Whoever holds its secret can open every account. */
export ledger complianceKey: JubjubPoint;
/** accountId -> the account's viewing scalar, encrypted to `complianceKey`. Written by `register`. */
export ledger escrow: Map<Bytes<32>, EcdhMask_Ciphertext>;
export ledger frozen: Set<Bytes<32>>;
export ledger paused: Boolean;

// ── Compliance witnesses ───────────────────────────────────────────────────

/**
 * The viewing scalar of `account`: `secretToScalar(EK)`. For the caller's own
 * account (register) the wallet derives it from its EK; for someone else's
 * (seize) the issuer's wallet opens the on-chain escrow with the compliance
 * secret, or uses a key the holder disclosed. Verified in-circuit either way:
 * `g^scalar` must equal the account's registered encryption key.
 */
witness wit_ViewingScalar(account: Bytes<32>): Field;

/** Fresh ephemeral scalar for the escrow ciphertext (one per registration). */
witness wit_EscrowRandomness(): Field;

/**
 * The plaintext the issuer's wallet recovered for `ct` using the viewing
 * scalar (memo replay or bounded discrete log). Verified in-circuit.
 */
witness wit_ViewedBalance(ct: ElGamal_Ciphertext): Uint<128>;

// ── Constructor ────────────────────────────────────────────────────────────

constructor(
  name_: Opaque<"string">,
  symbol_: Opaque<"string">,
  decimals_: Uint<8>,
  issuer: Bytes<32>,
  compliancePk: JubjubPoint
) {
  CFT_initialize(name_, symbol_, decimals_);
  Ownable_initialize(Either<Bytes<32>, ContractAddress> {
    is_left: true,
    left: issuer,
    right: default<ContractAddress>
  });
  assert(compliancePk != ecMulGenerator(0 as Field), "CFTDemo: identity compliance key");
  complianceKey = disclose(compliancePk);
  paused = false;
}

// ── Guards ─────────────────────────────────────────────────────────────────

circuit assertNotPaused(): [] {
  assert(!paused, "CFTDemo: paused");
}

circuit assertNotFrozen(account: Bytes<32>): [] {
  assert(!frozen.member(disclose(account)), "CFTDemo: account frozen");
}

/** `g^s == pk`: the scalar really is the viewing key behind this account. */
circuit assertViewingScalarFor(pk: JubjubPoint, s: Field): [] {
  assert(ecMulGenerator(s) == pk, "CFTDemo: viewing key does not match the account");
}

/** Exponential ElGamal opening with a scalar: `ct.c2 - s * ct.c1 == g^amount`. */
circuit assertOpensTo(ct: ElGamal_Ciphertext, s: Field, amount: Uint<128>): [] {
  const shared = ecMul(ct.c1, s);
  // The 0.23 stdlib has no point negation; ElGamal_negate negates both
  // components of a ciphertext, so wrap the shared point and take one back.
  const neg = ElGamal_negate(ElGamal_Ciphertext { c1: shared, c2: shared });
  const opened = ecAdd(ct.c2, neg.c1);
  assert(opened == ecMulGenerator(amount as Field), "CFTDemo: viewing key does not open the balance to this amount");
}

/** ECDH-masked encryption of a scalar to the compliance key (same construction as the OZ memo channel). */
circuit escrowEncrypt(s: Field, e: Field): EcdhMask_Ciphertext {
  assert(e != 0 as Field, "CFTDemo: zero escrow randomness");
  const ephemeralPk = ecMulGenerator(e);
  const shared = ecMul(complianceKey, e);
  return EcdhMask_Ciphertext {
    ephemeralPk: ephemeralPk,
    ct: s + EcdhMask_kdf(shared, pad(32, "CFTDemo_escrow_v1"))
  };
}

// ── Holder operations ──────────────────────────────────────────────────────

/**
 * Register the caller's encryption key (permissionless) and escrow the
 * matching viewing scalar to the compliance key. The proof binds the escrowed
 * scalar to the key just registered, so a holder cannot register one key and
 * escrow another. Returns the caller's accountId.
 */
export circuit register(): Bytes<32> {
  const id = CFT_register();
  const s = wit_ViewingScalar(id);
  assertViewingScalarFor(CFT__encryptionKeys.lookup(disclose(id)), s);
  escrow.insert(disclose(id), disclose(escrowEncrypt(s, wit_EscrowRandomness())));
  return id;
}

/** Move the caller's pending (incoming) pool into the spendable balance. */
export circuit sweep(): Bytes<32> {
  return CFT_sweep();
}

/**
 * Confidential transfer. Amount hidden; (sender, recipient) public.
 * Fails if paused or if either party is frozen.
 */
export circuit transfer(to: Bytes<32>, value: Uint<128>): Bytes<32> {
  assertNotPaused();
  assertNotFrozen(to);
  const sender = CFT_transfer(to, value);
  assertNotFrozen(sender);
  return sender;
}

/** Burn from the caller's own spendable balance; totalSupply decreases. */
export circuit burn(value: Uint<128>): Bytes<32> {
  assertNotPaused();
  const sender = CFT__burn(value);
  assertNotFrozen(sender);
  Supply__subSupply(value);
  return sender;
}

// ── Issuer operations ──────────────────────────────────────────────────────

/** Issuer-only mint; totalSupply increases by `value` (publicly). */
export circuit mint(account: Bytes<32>, value: Uint<128>): [] {
  Ownable_assertOnlyOwner();
  assertNotPaused();
  assertNotFrozen(account);
  Supply__addSupply(value);
  CFT__mint(account, value);
}

/** Freeze (true) or unfreeze (false) an account. Works on any registered id, known or not. */
export circuit setFrozen(account: Bytes<32>, isFrozen: Boolean): [] {
  Ownable_assertOnlyOwner();
  if (disclose(isFrozen)) {
    frozen.insert(disclose(account));
  } else {
    frozen.remove(disclose(account));
  }
}

/** Global circuit breaker for value movement. */
export circuit setPaused(isPaused: Boolean): [] {
  Ownable_assertOnlyOwner();
  paused = disclose(isPaused);
}

/**
 * Seize the entire balance (spendable + pending) of a FROZEN account and
 * credit it to `to`. The issuer's wallet supplies the account's viewing
 * scalar (opened from the escrow with the compliance secret, or disclosed by
 * the holder) and the amount it recovered with it; the circuit proves that
 * the scalar is the account's and that it opens the balance to exactly that
 * amount, so a wrong key or a wrong amount makes the proof fail.
 * The seized amount is not disclosed publicly; `to` learns it via its memo.
 * totalSupply is unchanged (the value moves, it is not burned).
 */
export circuit seize(account: Bytes<32>, to: Bytes<32>): [] {
  Ownable_assertOnlyOwner();
  assert(frozen.member(disclose(account)), "CFTDemo: seize requires a frozen account");
  assert(account != to, "CFTDemo: seize target equals source");
  assert(CFT__encryptionKeys.member(disclose(account)), "CFTDemo: account not registered");

  const pk = CFT__encryptionKeys.lookup(disclose(account));
  const total = ElGamal_add(
    CFT__balances.lookup(disclose(account)),
    CFT__pending.lookup(disclose(account))
  );

  const s = wit_ViewingScalar(account);
  const amount = wit_ViewedBalance(total);
  assertViewingScalarFor(pk, s);
  assertOpensTo(total, s, amount);

  CFT__balances.insert(disclose(account), ElGamal_encryptZero());
  CFT__pending.insert(disclose(account), ElGamal_encryptZero());

  // Conserving: credit the treasury with exactly what was removed.
  CFT__mint(to, amount);
}

// ── Pure helpers (run locally by wallets and viewers, no proof) ────────────

export pure circuit computeAccountId(sk: Bytes<32>): Bytes<32> {
  return CFT_computeAccountId(sk);
}

export pure circuit derivePk(ek: Bytes<32>): JubjubPoint {
  return ElGamal_derivePk(ek);
}

/** The viewing scalar behind an EK: what viewers use and what `register` escrows. */
export pure circuit viewingScalar(ek: Bytes<32>): Field {
  return ElGamal_secretToScalar(ek);
}

/** Open an escrow entry with the compliance secret: returns the account's viewing scalar. */
export pure circuit openEscrow(ct: EcdhMask_Ciphertext, complianceEk: Bytes<32>): Field {
  return EcdhMask_decrypt(ct, ElGamal_secretToScalar(complianceEk), pad(32, "CFTDemo_escrow_v1"));
}

/** Decrypt a credit memo with a viewing scalar; returns the delivered amount. */
export pure circuit decryptMemo(memo: EcdhMask_Ciphertext, s: Field): Field {
  return EcdhMask_decrypt(memo, s, pad(32, "OZ_CFT_ecdh_memo_v1"));
}

/** Decrypt a balance ciphertext to the point g^value (value recovered off-chain). */
export pure circuit decryptToPoint(ct: ElGamal_Ciphertext, s: Field): JubjubPoint {
  const shared = ecMul(ct.c1, s);
  const neg = ElGamal_negate(ElGamal_Ciphertext { c1: shared, c2: shared });
  return ecAdd(ct.c2, neg.c1);
}

/** g^value, for viewers verifying a claimed balance or building a lookup table. */
export pure circuit valuePoint(value: Uint<128>): JubjubPoint {
  return ecMulGenerator(value as Field);
}

export pure circuit addCiphertexts(a: ElGamal_Ciphertext, b: ElGamal_Ciphertext): ElGamal_Ciphertext {
  return ElGamal_add(a, b);
}
